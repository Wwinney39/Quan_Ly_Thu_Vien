<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn Sách muốn mượn:"
        android:textStyle="bold"/>
    <!-- Spinner dùng để sổ xuống chọn Sách -->
    <Spinner
        android:id="@+id/spnBooks"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/edtNguoiMuon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Họ tên người mượn"/>
    <EditText android:id="@+id/edtSdt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Số điện thoại"
        android:inputType="phone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/edtNgayMuon"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Ngày mượn (dd/mm/yyyy)"/>
        <EditText
            android:id="@+id/edtNgayTra"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Ngày trả (dd/mm/yyyy)"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveTicket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lưu Phiếu Mượn"
        android:layout_marginTop="20dp"/>
</LinearLayout>